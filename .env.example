# Azure SQL Database connection string (the ADO.NET string from the portal:
# your SQL database -> Connection strings -> ADO.NET). Fill in your password.
# Holds accounts + file metadata. Example shape:
# AZURE_SQL_CONNECTION_STRING=Server=tcp:YOUR-SERVER.database.windows.net,1433;Database=storelab;User Id=YOUR-USER;Password=YOUR-PASSWORD;Encrypt=true;TrustServerCertificate=false
AZURE_SQL_CONNECTION_STRING=

# Azure Storage account CONNECTION STRING (not just the access key).
# Storage account -> Security + networking -> Access keys -> Connection string.
# Holds file BYTES (Blob for My Files, Azure Files for the Shared area).
AZURE_STORAGE_CONNECTION_STRING=

# Recommended: a fixed random value so sessions survive restarts (openssl rand -hex 32).
# If unset, a random per-restart secret is used.
# SESSION_SECRET=

# Optional: port to listen on (defaults to 3000).
# PORT=3000
